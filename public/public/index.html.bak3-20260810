<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Frank Watson - Trance DJ &amp; Producer</title>
<meta name="description" content="Frank Watson - Belgian trance DJ &amp; producer since 2007. Uplifting &amp; energetic trance / tech-trance. Resident DJ at X-Ray FM. Releases on Black Hole Recordings, Always Alive, Enhanced, Discover &amp; Redux." />
<meta property="og:title" content="Frank Watson - Trance DJ &amp; Producer" />
<meta property="og:description" content="Belgian trance DJ &amp; producer. Trance is a mood." />
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎧</text></svg>" />
<!-- Fonts are self-hosted locally (no external requests to Google) -->
<link rel="preload" href="fonts/oswald-700.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
<style>
  @font-face{font-family:'Oswald';font-style:normal;font-weight:400;font-display:swap;src:url('fonts/oswald-400.woff2') format('woff2')}
  @font-face{font-family:'Oswald';font-style:normal;font-weight:500;font-display:swap;src:url('fonts/oswald-500.woff2') format('woff2')}
  @font-face{font-family:'Oswald';font-style:normal;font-weight:600;font-display:swap;src:url('fonts/oswald-600.woff2') format('woff2')}
  @font-face{font-family:'Oswald';font-style:normal;font-weight:700;font-display:swap;src:url('fonts/oswald-700.woff2') format('woff2')}
  @font-face{font-family:'Inter';font-style:normal;font-weight:400;font-display:swap;src:url('fonts/inter-400.woff2') format('woff2')}
  @font-face{font-family:'Inter';font-style:normal;font-weight:500;font-display:swap;src:url('fonts/inter-500.woff2') format('woff2')}
  @font-face{font-family:'Inter';font-style:normal;font-weight:600;font-display:swap;src:url('fonts/inter-600.woff2') format('woff2')}
  :root{
    --bg:#07040d; --bg2:#120a1e; --card:#170e26;
    --purple:#a855f7; --purple2:#7c3aed; --magenta:#c026d3; --cyan:#22d3ee;
    --text:#ece7f5; --muted:#a99fc0; --line:rgba(168,85,247,.24);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
  body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);line-height:1.6;overflow-x:hidden}
  img{max-width:100%;display:block}
  h1,h2,h3,.dj{font-family:'Oswald',sans-serif;letter-spacing:.02em}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:1080px;margin:0 auto;padding:0 22px}
  section{padding:88px 0;position:relative}
  .eyebrow{font-family:'Oswald';text-transform:uppercase;letter-spacing:.32em;font-size:12px;color:var(--purple);margin-bottom:14px}
  h2{font-size:clamp(26px,5.5vw,44px);text-transform:uppercase;font-weight:700;margin-bottom:26px;line-height:1.05;
    background:linear-gradient(90deg,#fff 0%,#d9b8ff 60%,var(--magenta) 120%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}

  #bar{position:fixed;top:0;left:0;height:3px;width:0;z-index:60;background:linear-gradient(90deg,var(--purple2),var(--magenta),var(--cyan));box-shadow:0 0 12px rgba(168,85,247,.7)}

  header{position:fixed;inset:3px 0 auto 0;z-index:50;backdrop-filter:blur(12px);background:rgba(7,4,13,.72);border-bottom:1px solid var(--line)}
  nav{display:flex;align-items:center;justify-content:space-between;height:60px;gap:12px}
  nav .brand{font-family:'Oswald';font-weight:700;letter-spacing:.16em;font-size:16px;white-space:nowrap;display:flex;align-items:center;gap:10px}
  nav .brand span{color:var(--purple)}
  nav ul{display:flex;gap:22px;list-style:none}
  nav ul a{font-family:'Oswald';text-transform:uppercase;font-size:13px;letter-spacing:.12em;color:var(--muted);transition:color .2s;position:relative}
  nav ul a:hover,nav ul a.active{color:var(--text)}
  nav ul a.active::after{content:"";position:absolute;left:0;right:0;bottom:-6px;height:2px;background:linear-gradient(90deg,var(--purple),var(--magenta));border-radius:2px}
  @media(max-width:560px){nav ul{gap:13px}nav ul a{font-size:11px;letter-spacing:.06em}nav .brand{font-size:13px}}

  .eq{display:inline-flex;gap:3px;height:16px;align-items:flex-end}
  .eq i{width:3px;height:40%;background:linear-gradient(var(--cyan),var(--magenta));border-radius:2px;animation:eq .9s ease-in-out infinite}
  .eq i:nth-child(2){animation-delay:.15s}.eq i:nth-child(3){animation-delay:.3s}.eq i:nth-child(4){animation-delay:.45s}.eq i:nth-child(5){animation-delay:.6s}
  @keyframes eq{0%,100%{height:25%}50%{height:100%}}

  .hero{min-height:100svh;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;background:#07040d}
  .hero::before{content:"";position:absolute;inset:-25% -25% 30% -25%;z-index:0;
    background:radial-gradient(circle at 32% 32%, rgba(168,85,247,.38), transparent 58%),
              radial-gradient(circle at 68% 42%, rgba(192,38,211,.32), transparent 55%),
              radial-gradient(circle at 50% 80%, rgba(34,211,238,.14), transparent 60%);
    filter:blur(26px);animation:aurora 15s ease-in-out infinite alternate}
  @keyframes aurora{0%{transform:translate3d(-3%,-2%,0) scale(1)}100%{transform:translate3d(4%,3%,0) scale(1.18)}}
  .grid{position:absolute;left:50%;bottom:-2px;width:230%;height:44vh;z-index:0;
    transform:translateX(-50%) perspective(420px) rotateX(62deg);transform-origin:bottom;
    background-image:linear-gradient(rgba(168,85,247,.55) 1px,transparent 1px),linear-gradient(90deg,rgba(168,85,247,.55) 1px,transparent 1px);
    background-size:46px 46px;animation:grid 3.4s linear infinite;
    -webkit-mask-image:linear-gradient(transparent,#000 45%);mask-image:linear-gradient(transparent,#000 45%)}
  @keyframes grid{to{background-position-y:46px}}
  .hero .inner{position:relative;z-index:1;padding:120px 0 90px}
  .hero .logo{width:min(880px,90vw);margin:0 auto;border-radius:14px;filter:drop-shadow(0 0 46px rgba(168,85,247,.5));animation:float 6s ease-in-out infinite}
  @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
  .hero .tag{font-family:'Oswald';text-transform:uppercase;letter-spacing:.3em;color:#fff;font-size:clamp(15px,3vw,22px);margin-top:84px;text-shadow:0 0 18px rgba(192,38,211,.55)}
  .hero .sub{color:var(--muted);max-width:560px;margin:16px auto 32px;font-size:clamp(15px,2.4vw,18px)}
  .cta{display:inline-flex;gap:12px;flex-wrap:wrap;justify-content:center}
  .btn{font-family:'Oswald';text-transform:uppercase;letter-spacing:.13em;font-size:15px;font-weight:600;padding:14px 28px;border-radius:40px;border:1px solid transparent;transition:transform .15s,box-shadow .25s,background .25s;cursor:pointer}
  .btn.primary{background:linear-gradient(90deg,var(--purple2),var(--magenta));color:#fff;box-shadow:0 8px 30px rgba(168,85,247,.4)}
  .btn.primary:hover{box-shadow:0 10px 42px rgba(192,38,211,.7)}
  .btn.ghost{border-color:var(--purple);color:var(--text)}
  .btn.ghost:hover{background:rgba(168,85,247,.14);box-shadow:0 0 26px rgba(168,85,247,.4)}
  .btn:hover{transform:translateY(-2px)}
  .scrolldot{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);z-index:1;color:var(--muted);font-size:12px;letter-spacing:.2em;font-family:'Oswald';animation:bob 1.8s ease-in-out infinite}
  @keyframes bob{0%,100%{transform:translate(-50%,0)}50%{transform:translate(-50%,6px)}}

  .reveal{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s ease}
  .reveal.in{opacity:1;transform:none}

  .labels{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#0b0616;overflow:hidden}
  .labels .track{display:flex;gap:46px;white-space:nowrap;width:max-content;padding:18px 0;animation:marq 24s linear infinite}
  .labels:hover .track{animation-play-state:paused}
  .labels span{font-family:'Oswald';text-transform:uppercase;letter-spacing:.14em;color:var(--muted);font-size:13px}
  .labels b{color:var(--purple);font-weight:600}
  @keyframes marq{to{transform:translateX(-50%)}}

  .about{background:linear-gradient(180deg,var(--bg),var(--bg2))}
  .about-layout{display:grid;grid-template-columns:1.35fr 1fr;gap:44px;align-items:center;max-width:1000px}
  .about-photo{position:relative}
  .about-photo img{width:100%;border-radius:16px;border:1px solid var(--line);box-shadow:0 22px 55px rgba(0,0,0,.45)}
  .about-photo::after{content:"";position:absolute;inset:-2px;border-radius:18px;pointer-events:none;box-shadow:0 0 0 1px rgba(168,85,247,.4),0 0 40px rgba(192,38,211,.35)}
  .about p{color:var(--muted);font-size:clamp(15px,2.3vw,17px);margin-bottom:14px}
  .about p strong{color:var(--text)}
  .stats{display:flex;gap:20px 40px;flex-wrap:wrap;margin-top:26px}
  .stat .n{font-family:'Oswald';font-size:clamp(24px,5vw,32px);font-weight:700;line-height:1;background:linear-gradient(90deg,var(--purple),var(--magenta));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .stat .l{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);margin-top:4px}
  @media(max-width:760px){.about-layout{grid-template-columns:1fr;gap:26px}.about-photo{order:-1;max-width:380px;margin:0 auto}}

  .music{background:var(--bg)}
  .embed-frame{border-radius:14px;overflow:hidden;border:1px solid var(--line);margin-bottom:16px;transition:box-shadow .25s,border-color .25s}
  .embed-frame:hover{border-color:var(--purple);box-shadow:0 0 30px rgba(168,85,247,.3)}

  .disco{background:linear-gradient(180deg,var(--bg2),var(--bg))}
  .rel{display:flex;align-items:baseline;gap:16px;padding:14px 12px;border-bottom:1px solid var(--line);border-radius:10px;transition:background .2s,transform .2s}
  .rel:hover{background:rgba(168,85,247,.07);transform:translateX(4px)}
  .rel .yr{font-family:'Oswald';color:var(--purple);font-weight:600;min-width:52px;font-size:15px}
  .rel .t{flex:1}.rel .t b{font-weight:600}.rel .t span{color:var(--muted);font-size:14px;display:block}
  .rel .buy{display:flex;gap:8px;flex-shrink:0;align-self:center}
  .sbtn{display:inline-flex;align-items:center;gap:7px;font-family:'Oswald';text-transform:uppercase;letter-spacing:.1em;
    font-size:11px;font-weight:600;padding:8px 14px;border-radius:30px;border:1px solid var(--line);color:var(--muted);
    background:rgba(255,255,255,.03);transition:color .2s,border-color .2s,background .2s,transform .15s,box-shadow .25s;white-space:nowrap}
  .sbtn svg{width:15px;height:15px;fill:currentColor;flex-shrink:0}
  .sbtn:hover{transform:translateY(-2px)}
  .sbtn.bp:hover{color:#a5f70b;border-color:rgba(165,247,11,.55);background:rgba(165,247,11,.10);box-shadow:0 0 20px rgba(165,247,11,.22)}
  .sbtn.sp:hover{color:#1ed760;border-color:rgba(30,215,96,.55);background:rgba(30,215,96,.10);box-shadow:0 0 20px rgba(30,215,96,.22)}
  .sbtn:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
  @media(max-width:720px){
    .rel{flex-wrap:wrap;align-items:flex-start}
    .rel .yr{min-width:44px}
    .rel .t{flex:1 1 100%;order:2;padding-left:60px;margin-top:-22px}
    .rel .buy{order:3;flex:1 1 100%;padding-left:60px;margin-top:10px}
    .sbtn{padding:7px 12px;font-size:10px}
  }
  @media(max-width:380px){.rel .t,.rel .buy{padding-left:0}.rel .t{margin-top:6px}}

  .shows{background:var(--bg)}
  .gig{display:flex;align-items:center;gap:20px;padding:18px 12px;border-bottom:1px solid var(--line);flex-wrap:wrap;border-radius:12px;transition:background .2s}
  .gig:hover{background:rgba(168,85,247,.06)}
  .gig .date{font-family:'Oswald';text-align:center;min-width:70px}
  .gig .date .d{font-size:28px;font-weight:700;line-height:1;color:var(--purple)}
  .gig .date .m{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:var(--muted)}
  .gig .info{flex:1;min-width:180px}
  .gig .info h3{font-family:'Oswald';font-size:clamp(17px,3.6vw,20px);text-transform:uppercase}
  .gig .info span{color:var(--muted);font-size:14px}
  .gig .tix{font-family:'Oswald';text-transform:uppercase;font-size:12px;letter-spacing:.12em;color:var(--purple);border:1px solid var(--purple);padding:9px 16px;border-radius:30px;white-space:nowrap;transition:.2s}
  .gig .tix:hover{background:var(--purple);color:#fff;box-shadow:0 0 20px rgba(168,85,247,.5)}
  .gig.past{opacity:.45}
  .gig .tix.soon{border-color:var(--cyan);color:var(--cyan)}
  .gig .poster{display:block;flex:0 0 auto;width:58px;height:82px;border-radius:8px;overflow:hidden;border:1px solid var(--line);background:#0b0b12;transition:.2s}
  .gig .poster img{width:100%;height:100%;object-fit:cover;display:block}
  .gig .poster:hover{border-color:var(--purple);box-shadow:0 0 18px rgba(168,85,247,.45);transform:translateY(-2px)}
  @media (max-width:520px){.gig .poster{width:46px;height:65px}}
  .gig-none{color:var(--muted);font-size:14px;padding:18px 12px}

  /* ---- X-Ray FM residency ---- */
  .radio{background:linear-gradient(180deg,var(--bg),var(--bg2))}
  .xr-head{margin-bottom:28px}
  .xr-live{display:inline-flex;align-items:center;gap:10px;font-family:'Oswald';text-transform:uppercase;
    letter-spacing:.14em;font-size:13px;padding:8px 16px;border-radius:30px;border:1px solid var(--line);
    background:rgba(255,255,255,.03);margin-bottom:14px}
  .xr-live .dot{width:9px;height:9px;border-radius:50%;background:var(--muted);flex-shrink:0}
  .xr-live.on{border-color:rgba(255,60,90,.6);color:#fff;background:rgba(255,60,90,.12)}
  .xr-live.on .dot{background:#ff3c5a;box-shadow:0 0 0 0 rgba(255,60,90,.7);animation:pulse 1.8s infinite}
  .xr-live.soon{border-color:rgba(34,211,238,.5)}
  .xr-live.soon .dot{background:var(--cyan)}
  @keyframes pulse{70%{box-shadow:0 0 0 12px rgba(255,60,90,0)}100%{box-shadow:0 0 0 0 rgba(255,60,90,0)}}
  .xr-sub{color:var(--muted);max-width:640px;margin-bottom:18px}
  .xr-btns{display:flex;gap:12px;flex-wrap:wrap}
  .xr-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px}
  .xr-load{color:var(--muted);font-size:14px;grid-column:1/-1;padding:10px 0}
  .xr-card{display:block;background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden;
    transition:transform .2s,box-shadow .25s,border-color .2s}
  .xr-card:hover{transform:translateY(-4px);border-color:var(--purple);box-shadow:0 14px 40px rgba(168,85,247,.28)}
  .xr-card .art{position:relative;aspect-ratio:1/1;background:#241536;overflow:hidden}
  .xr-card .art img{width:100%;height:100%;object-fit:cover;transition:transform .4s}
  .xr-card:hover .art img{transform:scale(1.05)}
  .xr-card .play{position:absolute;inset:0;display:grid;place-items:center;opacity:0;transition:opacity .25s;
    background:rgba(7,4,13,.5)}
  .xr-card:hover .play{opacity:1}
  .xr-card .play svg{width:44px;height:44px;fill:#fff;filter:drop-shadow(0 4px 14px rgba(0,0,0,.6))}
  .xr-card .meta{padding:13px 15px 15px}
  .xr-card .meta h3{font-size:14px;text-transform:uppercase;letter-spacing:.04em;line-height:1.3;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .xr-card .meta time{display:block;color:var(--muted);font-size:12px;margin-top:5px;font-family:'Oswald';letter-spacing:.1em}

  /* ---- Radio history timeline ---- */
  .rh{margin-top:56px}
  .rh h3{font-family:'Oswald';font-size:20px;text-transform:uppercase;letter-spacing:.12em;margin-bottom:22px;color:var(--text)}
  .rh-list{position:relative;padding-left:26px;border-left:1px solid var(--line)}
  .rh-item{position:relative;padding:0 0 26px 18px}
  .rh-item:last-child{padding-bottom:4px}
  .rh-item::before{content:"";position:absolute;left:-31px;top:6px;width:9px;height:9px;border-radius:50%;
    background:var(--bg);border:2px solid var(--purple)}
  .rh-item.now::before{background:var(--purple);box-shadow:0 0 12px rgba(168,85,247,.8)}
  .rh-item .years{font-family:'Oswald';font-size:12px;letter-spacing:.16em;color:var(--cyan);text-transform:uppercase}
  .rh-item h4{font-size:16px;text-transform:uppercase;letter-spacing:.05em;margin:4px 0 3px}
  .rh-item .st{color:var(--muted);font-size:14px}
  .rh-item .st b{color:var(--text);font-weight:600}

  .contact{background:linear-gradient(180deg,var(--bg),var(--bg2));text-align:center;overflow:hidden}
  .contact::before{content:"";position:absolute;inset:0;z-index:0;background:radial-gradient(circle at 50% 0%,rgba(168,85,247,.22),transparent 55%)}
  .contact .wrap{position:relative;z-index:1}
  .contact .big{font-family:'Oswald';font-size:clamp(28px,7vw,58px);text-transform:uppercase;font-weight:700;line-height:1.04;margin-bottom:16px;background:linear-gradient(90deg,#fff,#d9b8ff,var(--magenta));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .contact p{color:var(--muted);max-width:520px;margin:0 auto 28px}

  footer{border-top:1px solid var(--line);padding:36px 0;text-align:center;color:var(--muted);font-size:14px}
  .socials{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-bottom:18px}
  .socials a{width:44px;height:44px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;transition:.2s}
  .socials a:hover{background:var(--purple);border-color:var(--purple);transform:translateY(-3px);box-shadow:0 8px 22px rgba(168,85,247,.5)}
  .socials svg{width:20px;height:20px;fill:var(--text)}
  .tiny{font-size:12px;color:#6b6480;margin-top:8px}

  @media(max-width:640px){section{padding:64px 0}.hero .inner{padding:104px 0 80px}.hero .tag{margin-top:60px}.grid{height:34vh}}
  @media(prefers-reduced-motion:reduce){*{animation:none!important}.reveal{opacity:1;transform:none}}
</style>
</head>
<body>
<div id="bar"></div>
<div id="glow" aria-hidden="true"></div>
<canvas id="confetti" aria-hidden="true"></canvas>

<div id="loader">
  <div class="ld-inner">
    <img src="hero.png" alt="Frank Watson" class="ld-logo" />
    <div class="ld-eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <div class="ld-bar"><span></span></div>
    <div class="ld-txt">Loading the vibe…</div>
  </div>
</div>

<header>
  <nav class="wrap">
    <div class="brand">FRANK<span>·</span>WATSON <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span></div>
    <ul>
      <li><a href="#about">Bio</a></li>
      <li><a href="#music">Music</a></li>
      <li><a href="#radio">Radio</a></li><li><a href="#shows">Shows</a></li>
      <li><a href="#contact">Booking</a></li>
    </ul>
  </nav>
</header>

<section class="hero" id="top">
  <canvas id="shader" aria-hidden="true"></canvas>
  <canvas id="fx" aria-hidden="true"></canvas>
  <div class="grid" aria-hidden="true"></div>
  <div class="inner wrap">
    <h1 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Frank Watson</h1>
    <img class="logo" src="hero.png" alt="Frank Watson" />
    <div class="tag">Trance is a <span id="rot">mood</span>.</div>
    <p class="sub">Belgian trance DJ &amp; producer since 2007 - uplifting &amp; energetic trance / tech-trance.</p>
