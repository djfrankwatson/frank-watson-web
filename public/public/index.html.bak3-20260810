    var ctx=c.getContext('2d'),ps=[],raf=null,cols=['#a855f7','#c026d3','#22d3ee','#ffffff','#7c3aed'];
    function size(){c.width=innerWidth;c.height=innerHeight;} size(); addEventListener('resize',size,{passive:true});
    function loop(){ctx.clearRect(0,0,c.width,c.height);for(var i=0;i<ps.length;i++){var p=ps[i];p.vy+=0.15;p.x+=p.vx;p.y+=p.vy;p.a-=0.012;p.rot+=p.vr;if(p.a<=0)continue;ctx.save();ctx.globalAlpha=Math.max(0,p.a);ctx.translate(p.x,p.y);ctx.rotate(p.rot);ctx.fillStyle=p.c;ctx.fillRect(-p.s/2,-p.s/2,p.s,p.s*0.6);ctx.restore();}ps=ps.filter(function(p){return p.a>0&&p.y<c.height+40;});if(ps.length)raf=requestAnimationFrame(loop);else raf=null;}
    return function(x,y){if(reduce)return;for(var i=0;i<90;i++){var a=Math.random()*6.2832,sp=3+Math.random()*7;ps.push({x:x,y:y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-4,s:5+Math.random()*6,c:cols[(Math.random()*cols.length)|0],a:1,rot:Math.random()*6.28,vr:(Math.random()-0.5)*0.3});}if(!raf)raf=requestAnimationFrame(loop);};
  })();
  function hookConfetti(el){if(el)el.addEventListener('click',function(e){confettiBurst(e.clientX,e.clientY);});}
  hookConfetti(document.getElementById('cookie-accept'));
  document.querySelectorAll('a[href^="mailto:ccrs"], .cta a.ghost[href="#contact"]').forEach(hookConfetti);

  // 6. discography tilt + button spotlight
  if(!touch){
    document.querySelectorAll('.rel').forEach(function(r){
      r.addEventListener('pointermove',function(e){var b=r.getBoundingClientRect();var rx=((e.clientY-b.top)/b.height-0.5)*-6;var ry=((e.clientX-b.left)/b.width-0.5)*6;r.style.transform='perspective(600px) rotateX('+rx.toFixed(2)+'deg) rotateY('+ry.toFixed(2)+'deg)';});
      r.addEventListener('pointerleave',function(){r.style.transform='';});
    });
    document.querySelectorAll('.btn').forEach(function(b){
      b.addEventListener('pointermove',function(e){var r=b.getBoundingClientRect();b.style.setProperty('--bx',(e.clientX-r.left)+'px');b.style.setProperty('--by',(e.clientY-r.top)+'px');});
    });
  }
})();
</script>
<script>
/* ==================================================================
   SHOWS + X-RAY FM SESSIONS
   ==================================================================
   >>> TO ADD A GIG: copy one line in the GIGS list below and edit it.
       date : 'YYYY-MM-DD'  (required, used to sort and to auto-hide)
       name : venue / event name
       info : the small grey line underneath
       link : ticket or info URL - use '' for none
       Past dates disappear on their own. Nothing else to change.
   ================================================================== */
(function () {
  'use strict';

  var GIGS = [
    { date: '2026-09-04', name: 'X-Ray FM Party Nox Summerbar', info: 'Retro-house accented · X-Ray FM DJ-team · free entrance, doors 19h · Oostendelaan, Middelkerke', poster: 'poster-nox-2026-09-04.jpg', thumb: 'poster-nox-2026-09-04-thumb.jpg', link: 'poster-nox-2026-09-04.jpg', label: 'More info' },
    { date: '2026-09-11', name: 'Raptor Shooting Club - Beernem', info: 'DJ set with VJ TSFX · Industriepark Noord 11, 8730 Beernem', link: '' },
    { date: '2026-10-17', name: 'FSOE Amsterdam Weekender', info: 'Quest4Trance & Luminosity events · Amsterdam, NL', link: '' }
    // { date: '2026-12-31', name: 'New venue', info: 'Details here', link: 'https://tickets...' },
  ];

  /* ---- residency schedule: Friday & Saturday, 21:00-22:00 Brussels ---- */
  var SHOW_DAYS = [5, 6];      // 5 = Friday, 6 = Saturday
  var SHOW_START = 21, SHOW_END = 22;

  var MIXCLOUD_USER = 'DJ_Frank_Watson';
  var SESSION_COUNT = 4;

  // Shown if Mixcloud can't be reached. Safe to leave as is.
  var FALLBACK = [
    { title: 'Trance hour on X-Ray FM', url: 'https://www.mixcloud.com/DJ_Frank_Watson/', img: '', when: '' }
  ];

  function esc(t) {
    return String(t).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  /* ================= gigs ================= */
  (function () {
    var host = document.getElementById('gig-list');
    if (!host) return;
    var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    var today = new Date(); today.setHours(0, 0, 0, 0);

    var upcoming = GIGS.filter(function (g) {
      var d = new Date(g.date + 'T00:00:00');
      return !isNaN(d) && d >= today;
    }).sort(function (a, b) { return a.date < b.date ? -1 : 1; });

    // the residency always sits at the top
    var html = '<div class="gig">' +
      '<div class="date"><div class="d">FRI</div><div class="m">&amp; SAT</div></div>' +
      '<div class="info"><h3>Resident - X-Ray FM</h3>' +
      '<span>Trance every Friday &amp; Saturday evening · online, 106.8 FM &amp; DAB+ West Flanders</span></div>' +
      '<a class="tix" href="https://x-rayfm.be" target="_blank" rel="noopener">Tune in</a></div>';

    html += upcoming.map(function (g) {
      var d = new Date(g.date + 'T00:00:00');
      var days = Math.round((d - today) / 86400000);
      var soon = days <= 14;
      var label = g.label || (g.link ? 'Tickets' : 'Info');
      var btn = g.link
        ? '<a class="tix' + (soon ? ' soon' : '') + '" href="' + esc(g.link) + '" target="_blank" rel="noopener">' + label + '</a>'
        : '<a class="tix' + (soon ? ' soon' : '') + '" href="#contact">Info</a>';
      var note = days === 0 ? ' · <b>tonight</b>' : (soon ? ' · in ' + days + ' days' : '');
      var poster = g.poster
        ? '<a class="poster" href="' + esc(g.poster) + '" target="_blank" rel="noopener" '
          + 'aria-label="Event poster"><img src="' + esc(g.thumb || g.poster) + '" alt="' + esc(g.name)
          + ' poster" loading="lazy" onerror="this.parentNode.style.display=&quot;none&quot;"></a>'
        : '';
      return '<div class="gig"><div class="date"><div class="d">' + d.getDate() + '</div>' +
        '<div class="m">' + months[d.getMonth()] + " '" + String(d.getFullYear()).slice(2) + '</div></div>' +
        poster +
        '<div class="info"><h3>' + esc(g.name) + '</h3><span>' + esc(g.info) + note + '</span></div>' + btn + '</div>';
    }).join('');

    host.innerHTML = html;
    var none = document.getElementById('gig-none');
    if (none && !upcoming.length) none.hidden = false;
  })();

  /* ================= live-now indicator ================= */
  (function () {
    var wrap = document.querySelector('.xr-live');
    var txt = document.getElementById('xr-status');
    if (!wrap || !txt) return;
    var dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

    function tick() {
      // always evaluate in Brussels time, whatever the visitor's timezone
      var parts, now = new Date();
      try {
        var f = new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Europe/Brussels', weekday: 'short', hour: 'numeric', hour12: false
        }).formatToParts(now);
        parts = {};
        f.forEach(function (p) { parts[p.type] = p.value; });
      } catch (e) { parts = null; }

      var wd, hr;
      if (parts) {
        wd = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(parts.weekday);
        hr = parseInt(parts.hour, 10);
      } else {
        wd = now.getDay(); hr = now.getHours();
      }
      if (wd < 0) { wd = now.getDay(); hr = now.getHours(); }

      var onAir = SHOW_DAYS.indexOf(wd) !== -1 && hr >= SHOW_START && hr < SHOW_END;
      wrap.classList.toggle('on', onAir);

      if (onAir) {
        txt.innerHTML = 'On air right now';
        return;
      }
      // find the next show day
      for (var i = 0; i < 8; i++) {
        var d = (wd + i) % 7;
        if (SHOW_DAYS.indexOf(d) === -1) continue;
        if (i === 0 && hr >= SHOW_END) continue;
        wrap.classList.toggle('soon', i === 0);
        txt.textContent = (i === 0 ? 'Tonight' : (i === 1 ? 'Tomorrow' : dayNames[d])) +
          ' · ' + SHOW_START + ':00-' + SHOW_END + ':00 CET';
        return;
      }
      txt.textContent = 'Every Friday & Saturday evening';
    }
    tick();
    setInterval(tick, 60000);
  })();

  /* ================= latest Mixcloud sessions ================= */
  (function () {
    var grid = document.getElementById('xr-grid');
    if (!grid) return;

    var PLAY = '<span class="play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.14v13.72L19 12 8 5.14Z"/></svg></span>';

    function card(it) {
      var art = it.img
        ? '<img src="' + esc(it.img) + '" alt="" loading="lazy" width="300" height="300" />'
        : '';
      return '<a class="xr-card" href="' + esc(it.url) + '" target="_blank" rel="noopener" ' +
        'data-store="Mixcloud" data-track="' + esc(it.title) + '">' +
        '<span class="art">' + art + PLAY + '</span>' +
        '<span class="meta"><h3>' + esc(it.title) + '</h3>' +
        (it.when ? '<time>' + esc(it.when) + '</time>' : '') +
        '</span></a>';
    }

    function paint(items) {
      grid.innerHTML = items.map(card).join('');
    }

    function fmtDate(iso) {
      var d = new Date(iso);
      if (isNaN(d)) return '';
      return d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });
    }

    var done = false;
    var timer = setTimeout(function () { if (!done) { done = true; paint(FALLBACK); } }, 6000);

    fetch('https://api.mixcloud.com/' + MIXCLOUD_USER + '/cloudcasts/?limit=' + SESSION_COUNT)
      .then(function (r) { if (!r.ok) throw 0; return r.json(); })
      .then(function (j) {
        if (done) return;
        done = true; clearTimeout(timer);
        var list = (j && j.data) || [];
        if (!list.length) { paint(FALLBACK); return; }
        paint(list.slice(0, SESSION_COUNT).map(function (c) {
          return {
            title: c.name || 'Session',
            url: c.url || 'https://www.mixcloud.com/' + MIXCLOUD_USER + '/',
            img: (c.pictures && (c.pictures.large || c.pictures['320wx320h'] || c.pictures.medium)) || '',
            when: fmtDate(c.created_time)
          };
        }));
      })
      .catch(function () {
        if (done) return;
        done = true; clearTimeout(timer);
        paint(FALLBACK);
      });
  })();
})();
</script>
